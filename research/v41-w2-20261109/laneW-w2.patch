+/* V4_WEX_BATCH's prefetch twin (v4_np.mutex held): the guesses queued after
+ * twins[0] for its store, layer and forward that also load straight to VRAM
+ * (direct(rank)), up to max in all, taken out of the queue; the rest keep their
+ * order. Returns the count, twins[0] included. */
+static int v4_np_take_twins(V4NpItem *twins, int max, int (*direct)(int rank)) {
+    int n = 1, w = v4_np.head;
+    for (int r = v4_np.head; r != v4_np.tail; r = (r + 1) % V4_NP_QUEUE) {
+        const V4NpItem *q = &v4_np.queue[r];
+        if (n < max && q->store == twins[0].store && q->key.layer == twins[0].key.layer &&
+            q->stamp == twins[0].stamp && direct(q->rank))
+            twins[n++] = *q;
+        else {
+            if (w != r) v4_np.queue[w] = *q;
+            w = (w + 1) % V4_NP_QUEUE;
+        }
+    }
+    v4_np.tail = w;
+    return n;
+}
