+        b->slots[i] = b->drained ? coli_v4_wex_crc_get(b->store, b->keys[i], b->entries[i],
+                                                       &b->records[i], &b->hits[i]) : -1;
+        if (b->slots[i] < 0) { b->records[i] = NULL; want += b->drained; }
+    }
+    if (want) b->lent = v4_wexb_take(b->need, want, ring, b->ring_ids);
+    ColiExpertKey read_keys[V4_WEXB_MAX];
+    const WexEntry *read_entries[V4_WEXB_MAX];
+    unsigned char *read_dst[V4_WEXB_MAX];
+    for (int i = 0, k = 0; i < b->n; i++) {
+        if (!b->records[i] && k < b->lent) b->records[i] = ring[k++];
