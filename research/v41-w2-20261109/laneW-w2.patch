+void *coli_v4_expert_store_wex_read_issue(ColiExpertStore *store, int n, const ColiExpertKey *keys,
+                                          const WexEntry *const *entries, unsigned char *const *dst) {
+    static __thread HANDLE events[COLI_V4_WEX_BATCH_MAX];   /* one batch in flight a thread */
+    if (!store || !store->state || n < 1 || n > COLI_V4_WEX_BATCH_MAX) return NULL;
+    V4WexReads *r = calloc(1, sizeof(*r));
+    if (!r) return NULL;
+    V4ExpertStoreState *state = store->state;
+    int open = state->wex_handle != INVALID_HANDLE_VALUE;
+    r->state = state;
+    r->n = n;
+    clock_gettime(CLOCK_MONOTONIC, &r->t0);
+    for (int i = 0; i < n; i++) {
+        r->entries[i] = entries[i];
+        if (!open || !entries[i] || !dst[i] || !WEX_IS_ALIGNED(dst[i], WEX_ALIGN)) continue;
+        if (!events[i] && !(events[i] = CreateEventA(NULL, TRUE, FALSE, NULL))) continue;
+        OVERLAPPED *ov = &r->ov[i];
+        ov->Offset = (DWORD)(entries[i]->file_offset & 0xFFFFFFFFULL);
+        ov->OffsetHigh = (DWORD)((entries[i]->file_offset >> 32) & 0xFFFFFFFFULL);
+        ov->hEvent = events[i];
+        ResetEvent(events[i]);
+        r->files[i] = v4_wex_pick(state, keys[i].layer, keys[i].expert);
+        DWORD got = 0;
+        if (ReadFile(r->files[i], dst[i], entries[i]->total_bytes, &got, ov)) {
+            r->ok[i] = got == entries[i]->total_bytes;
+            r->done[i] = v4_wex_reads_since(&r->t0);
+        } else
+            r->pending[i] = GetLastError() == ERROR_IO_PENDING;
+    }
+    return r;
+}
