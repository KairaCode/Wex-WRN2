+/* any entry with this key, loading or not (no LRU touch) */
+static int v4_gpu_mirror_has(V4GpuExpertMirrorCache *cache, ColiExpertKey key) {
+    int has = 0;
+    pthread_mutex_lock(&cache->mutex);
+    for (int i = 0; i < cache->count && !has; i++)
+        has = cache->entries[i].layer == key.layer && cache->entries[i].expert == key.expert;
+    pthread_mutex_unlock(&cache->mutex);
+    return has;
+}
