+typedef struct {   /* the reads of one batch in flight */
+    V4ExpertStoreState *state;
+    int n, ok[COLI_V4_WEX_BATCH_MAX], pending[COLI_V4_WEX_BATCH_MAX];
+    const WexEntry *entries[COLI_V4_WEX_BATCH_MAX];
+    OVERLAPPED ov[COLI_V4_WEX_BATCH_MAX];   /* fixed address while a read is pending */
+    HANDLE files[COLI_V4_WEX_BATCH_MAX];
+    double done[COLI_V4_WEX_BATCH_MAX];
+    struct timespec t0;
+} V4WexReads;
+
+static double v4_wex_reads_since(const struct timespec *t0) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (double)(t.tv_sec - t0->tv_sec) + (t.tv_nsec - t0->tv_nsec) * 1e-9;
+}
