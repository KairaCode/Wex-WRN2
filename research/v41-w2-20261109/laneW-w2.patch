+/* ---- V4_WEX_BATCH=1 (default off): the WNR2 misses of one layer in one decode.
+ * The per-record path above costs one helper call and one host wait per expert
+ * (~1 ms); here the misses are reserved as mirrors together (one victim drain),
+ * their records come from the RAM cache of compressed records or from
+ * overlapped reads into a shared page-locked ring, one
+ * wex_cuda_decode_batch_to_device call reconstructs them all, and each is
+ * published or, if any step refused it, released and left to the per-record
+ * path. Never waits on an expert another thread is loading (a batch holds
+ * several mirrors: two batches waiting on each other would deadlock). */
+#ifdef _WIN32
+enum { V4_WEXB_RING = 16 };   /* staging buffers, allocated on first use */
+static struct {
+    pthread_mutex_t mutex;
+    unsigned char *buffer[V4_WEXB_RING];
+    unsigned lent;   /* bit i: buffer[i] is in a batch */
+    size_t bytes;
+    /* wexprof, [0] demand [1] prefetch: calls, records reserved, published, ns */
+    unsigned long long calls[2], records[2], published[2], read_ns[2], decode_ns[2];
+} v4_wexb = {.mutex = PTHREAD_MUTEX_INITIALIZER};
+
+static int v4_wexb_take(size_t bytes, int want, unsigned char **out, int *ids) {
+    int got = 0;
+    pthread_mutex_lock(&v4_wexb.mutex);
+    if (!v4_wexb.bytes) v4_wexb.bytes = bytes;   /* the record size is fixed per model */
+    for (int i = 0; i < V4_WEXB_RING && got < want && v4_wexb.bytes >= bytes; i++) {
+        if (v4_wexb.lent & (1u << i)) continue;
+        if (!v4_wexb.buffer[i]) {
+            v4_wexb.buffer[i] = _aligned_malloc(v4_wexb.bytes, WEX_ALIGN);
+            if (!v4_wexb.buffer[i]) break;
+            (void)coli_wex_cuda_host_register(v4_wexb.buffer[i], v4_wexb.bytes);   /* pageable still works */
+        }
+        v4_wexb.lent |= 1u << i;
+        ids[got] = i;
+        out[got++] = v4_wexb.buffer[i];
+    }
+    pthread_mutex_unlock(&v4_wexb.mutex);
+    return got;
+}
+
+static void v4_wexb_give(const int *ids, int n) {
+    pthread_mutex_lock(&v4_wexb.mutex);
+    for (int i = 0; i < n; i++) v4_wexb.lent &= ~(1u << ids[i]);
+    pthread_mutex_unlock(&v4_wexb.mutex);
+}
