+int coli_v4_expert_store_wex_read_wait(void *reads, int *ok) {
+    V4WexReads *r = reads;
+    if (!r) return 0;
+    /* every issued read is waited for: a buffer is never handed back while one writes it */
+    for (int i = 0; i < r->n; i++) {
+        if (!r->pending[i]) continue;
+        DWORD got = 0;
+        r->ok[i] = GetOverlappedResult(r->files[i], &r->ov[i], &got, TRUE) &&
+                   got == r->entries[i]->total_bytes;
+        r->done[i] = v4_wex_reads_since(&r->t0);
+    }
+    /* disk_sec sums per-read latencies, as the per-record reads on parallel lanes do */
+    double sum = 0.0;
+    uint64_t bytes = 0;
+    int count = 0;
+    for (int i = 0; i < r->n; i++) {
+        ok[i] = r->ok[i];
+        if (ok[i]) { count++; sum += r->done[i]; bytes += r->entries[i]->total_bytes; }
+    }
+    pthread_mutex_lock(&r->state->mutex);
+    r->state->disk_sec += sum;
+    pthread_mutex_unlock(&r->state->mutex);
+    __atomic_fetch_add(&v4_wex_direct_reads, (uint64_t)count, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&v4_wex_direct_bytes, bytes, __ATOMIC_RELAXED);
+    free(r);
+    return count;
+}
