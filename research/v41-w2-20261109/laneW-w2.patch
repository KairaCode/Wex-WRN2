+/* times are wall per call: a batch's read and decode spans, a record's own read and decode */
+static void v4_wexb_report(void) {
+    pthread_mutex_lock(&v4_wexb.mutex);
+    for (int p = 0; p < 2; p++) {
+        unsigned long long n = v4_wexb.published[p], *r = v4_wexb_record[p];
+        fprintf(stderr, "wexprof %s batches=%llu reserved=%llu published=%llu per_batch=%.2f "
+                        "read_ms=%.1f decode_ms=%.1f decode_ms_per_record=%.3f | per-record "
+                        "loads=%llu read_ms=%.1f decode_ms=%.1f read_ms_per_record=%.3f "
+                        "decode_ms_per_record=%.3f\n",
+                p ? "prefetch" : "demand", v4_wexb.calls[p], v4_wexb.records[p], n,
+                v4_wexb.calls[p] ? (double)v4_wexb.records[p] / v4_wexb.calls[p] : 0.0,
+                v4_wexb.read_ns[p] * 1e-6, v4_wexb.decode_ns[p] * 1e-6,
+                n ? v4_wexb.decode_ns[p] * 1e-6 / n : 0.0,
+                r[0], r[1] * 1e-6, r[2] * 1e-6, r[0] ? r[1] * 1e-6 / r[0] : 0.0,
+                r[0] ? r[2] * 1e-6 / r[0] : 0.0);
+    }
+    pthread_mutex_unlock(&v4_wexb.mutex);
+}
