+static inline void wexf_two_level_init(WexFastModel *f, size_t ctx, const unsigned char *cdf) {
+    const uint32_t S = WEXF_ASHIFT, B = 1u << WEXF_ASHIFT;
+    uint32_t c[17], i, s;
