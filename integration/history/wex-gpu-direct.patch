+        if (slot >= 0) coli_v4_wex_crc_done(f->store, slot, 0);
+        return -1;
+    }
+    int status = coli_wex_cuda_decode_to_device(f->entry, record, f->device, scale, weight);
+    if (slot >= 0) coli_v4_wex_crc_done(f->store, slot, hit || status == 0);
+    return status;
+}
