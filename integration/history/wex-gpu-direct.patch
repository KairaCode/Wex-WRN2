+        t->data_bytes = (size_t)entry->weight_shapes[m][0] * entry->weight_shapes[m][1];
+        t->scale_bytes = (size_t)entry->scale_shapes[m][0] * entry->scale_shapes[m][1];
+        t->block_rows = 1;
+        t->block_columns = 32;
