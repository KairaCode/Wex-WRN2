+                               cudaMemcpyDeviceToDevice,workspace.stream));
+        RUN_OK(cudaMemcpyAsync(dst_weight[m],workspace.device_raw+entry->weight_offsets[m],weight_bytes,
+                               cudaMemcpyDeviceToDevice,workspace.stream));
+    }
+    RUN_OK(cudaStreamSynchronize(workspace.stream)); guard.completed=true;
+#undef RUN_OK
+    return 0;
+}
