+                                      workspace.device_raw,workspace.lut,workspace.device_error,workspace.stream));
+    RUN_OK(cudaMemcpyAsync(workspace.host_error,workspace.device_error,4u,cudaMemcpyDeviceToHost,workspace.stream));
